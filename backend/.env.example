# Chave da API do Google Gemini (obtenha gratuitamente no Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelos oficiais de última geração (Google GenAI 2.x)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Porta do servidor (padrão 8000 local, no Render é configurada automaticamente pela variável PORT)
PORT=8000
